{
  "name": "auravote",
  "version": "1.0.0",
  "description": "AuraVote - Privacy-Preserving Zero-Knowledge Voting Protocol on Midnight Network",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "compile": "node scripts/compile-compact.mjs",
    "compile:skip-zk": "node scripts/compile-compact.mjs --skip-zk",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:preprod": "tsx scripts/deploy-preprod.ts",
    "generate:proofs": "node scripts/generate-proof-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "midnight",
    "compact",
    "zero-knowledge",
    "zk-snark",
    "privacy",
    "voting",
    "dao",
    "governance",
    "preprod"
  ],
  "author": "AuraVote Core Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
